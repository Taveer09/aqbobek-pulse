{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": { "api/handler.ts": { "maxDuration": 60 } },
  "routes": [
    { "src": "/(api|mock)/(.*)", "dest": "/api/handler?route=/$1/$2" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
